{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "jsx": "react-jsx",
    "paths": {
      "src/*": ["src/*"]
    }
  },
  "include": [
    "src",
    "App.tsx",
    "index.js",
    "env.d.ts",
    "__tests__",
    "__mocks__"
  ],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js"
  ]
}
